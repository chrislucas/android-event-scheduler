<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissões: cada uma está justificada em docs/permissoes.md (exigido pelo steering).
         RequestedPermissionsGuardRobolectricTest falha se esta lista mudar sem atualizar o documento. -->

    <!-- Alarmes (spec 04): notificações de lembrete/evento (Android 13+, pedida em tempo de execução). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Alarmes exatos no Android 13+: indicada pela documentação para apps de calendário/lembretes;
         exige declaração na Play Console (ver docs/permissoes.md). -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- Alarmes exatos no Android 12/12L (USE_EXACT_ALARM só existe a partir do Android 13). -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <!-- Alerta de evento em tela cheia (spec 14); no Android 14+ pode ser negada e o app cai para notificação. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Pós-boot (spec 15): reagendar os alarmes após reiniciar o aparelho (o AlarmManager os perde). -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:name=".app.RememberMeApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidEventScheduler">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.AndroidEventScheduler.Starting"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Importar agenda (spec 17): "Abrir com" o RememberMe num arquivo .json (anexo de e-mail, gerenciador de
                 arquivos). A MainActivity já é exportada (launcher), então o intent é não confiável: só content://
                 e application/json casam aqui, sem BROWSABLE (links da web não abrem a importação), e o código
                 revalida ação, MIME e esquema antes de usar a URI (ver IncomingFileIntent). -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />

                <data
                    android:mimeType="application/json"
                    android:scheme="content" />
            </intent-filter>

            <!-- Importar agenda (spec 17): "Compartilhar com" o RememberMe um arquivo .json (a URI vem em EXTRA_STREAM). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />

                <category android:name="android.intent.category.DEFAULT" />

                <data android:mimeType="application/json" />
            </intent-filter>
        </activity>

        <!-- Alarmes (spec 04): disparo do alarme agendado; só o sistema (AlarmManager) o aciona. -->
        <receiver
            android:name=".core.alarm.data.ScheduleAlarmReceiver"
            android:exported="false" />

        <!-- Tela cheia (spec 14): alerta de evento sobre a tela de bloqueio, aberto pelo fullScreenIntent da notificação.
             Sem <data>: o PendingIntent da spec 04 só envia ação + extra. showWhenLocked/turnScreenOn dispensam permissão. -->
        <activity
            android:name=".feature.alarm.presentation.screen.FullScreenAlarmActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:showWhenLocked="true"
            android:taskAffinity=""
            android:theme="@style/Theme.AndroidEventScheduler"
            android:turnScreenOn="true">
            <intent-filter>
                <action android:name="com.br.androideventscheduler.action.SHOW_FULL_SCREEN_ALARM" />

                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Pós-boot (spec 15): reagenda os alarmes após boot, atualização do app, mudança de fuso/hora e da permissão
             de alarme exato. Só ações do sistema, então exported=false basta; sem LOCKED_BOOT_COMPLETED nem
             directBootAware (o Room fica em armazenamento protegido por credencial). -->
        <receiver
            android:name=".core.alarm.data.BootCompletedReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <action android:name="android.intent.action.TIMEZONE_CHANGED" />
                <action android:name="android.intent.action.TIME_SET" />
                <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
            </intent-filter>
        </receiver>

        <!-- Koin é iniciado pelo App Startup, antes de Application.onCreate, Activities e Receivers. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="com.br.androideventscheduler.app.KoinInitializer"
                android:value="androidx.startup" />
            <!-- Alarmes (spec 04): canais de notificação criados na inicialização. -->
            <meta-data
                android:name="com.br.androideventscheduler.core.alarm.data.notification.NotificationChannelsInitializer"
                android:value="androidx.startup" />
        </provider>

        <!-- Importar/exportar (spec 17): FileProvider para entregar o arquivo exportado ao share sheet (e-mail, Drive...).
             exported=false: só recebe acesso quem ganhar permissão de leitura por URI (grantUriPermissions); expõe apenas
             cacheDir/exports/ (res/xml/file_paths.xml). Dispensa qualquer permissão de armazenamento. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>